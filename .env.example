# Copy to .env for local development only; .env is ignored by Git.
# Run: node --env-file=.env server/server.mjs
# On Render, enter these in the Web Service's Environment settings instead.
OPENAI_API_KEY=
YOUTUBE_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=https://luckwei.github.io,http://localhost:5173
PORT=3000

# Optional downloads: Docker includes yt-dlp + FFmpeg. Requires APP_ACCESS_TOKEN.
ENABLE_YOUTUBE_DOWNLOADS=false
# Local installs may override the executable (Docker already sets this).
# YT_DLP_PATH=/absolute/path/to/venv/bin/yt-dlp
